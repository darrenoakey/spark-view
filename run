#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$SCRIPT_DIR/src"
OUTPUT_DIR="$SCRIPT_DIR/output"
BIN_DIR="$OUTPUT_DIR/bin"
TEST_DIR="$OUTPUT_DIR/testing"
APP_BUNDLE="$OUTPUT_DIR/SparkView.app"
APP_EXE="$APP_BUNDLE/Contents/MacOS/sparkview"
BUNDLE_ID="com.darrenoakey.sparkview"

mkdir -p "$BIN_DIR" "$TEST_DIR"

usage() {
    echo "Usage: $0 <command> [args]"
    echo ""
    echo "Commands:"
    echo "  build              Build binaries and the signed SparkView.app bundle"
    echo "  test [pkg] [args]  Run tests for a specific package"
    echo "  lint               Run gofmt, go vet, and golangci-lint"
    echo "  check              Full quality gate (lint + all tests)"
    echo "  run [args]         Build and run the main binary"
    echo "  install            Install the supervising launcher to ~/bin/sparkview"
    echo "  rebuild            Build, install launcher, and restart via auto"
    echo "  logs               Tail the live Spark View log (auto-captured)"
    exit 1
}

# signing_identity finds a STABLE code-signing identity (Apple Development /
# Developer ID for Darren Oakey). A stable identity is what makes the macOS Local
# Network grant survive rebuilds: TCC keys on the Designated Requirement (Team ID
# + bundle id), which is constant across builds and even cert renewals. Falls back
# to ad-hoc ("-") with a warning — ad-hoc changes identity every build, so the
# grant would NOT persist.
signing_identity() {
    local id
    id="$( (security find-identity -v -p codesigning 2>/dev/null \
            | grep -E "Apple Development: Darren Oakey|Developer ID Application: " \
            | head -1 | awk '{print $2}') || true )"
    if [ -n "$id" ]; then
        echo "$id"
    else
        echo "-"
    fi
}

cmd_build() {
    echo "==> Building..."
    cd "$SRC_DIR"
    for dir in cmd/*/; do
        name=$(basename "$dir")
        go build -o "$BIN_DIR/$name" "./$dir"
        echo "    Built $name -> output/bin/$name"
    done
    cmd_bundle
    echo "==> Build complete."
}

# cmd_bundle assembles output/SparkView.app around the built binary and code-signs
# it with a stable identity + fixed bundle id, so macOS attributes Local Network
# access to the bundle (not the launcher) and the user's one-time grant persists
# across rebuilds. See CLAUDE.md "Local Network privacy".
cmd_bundle() {
    local id; id="$(signing_identity)"
    echo "==> Bundling SparkView.app (sign id: $id)"
    rm -rf "$APP_BUNDLE"
    mkdir -p "$APP_BUNDLE/Contents/MacOS" "$APP_BUNDLE/Contents/Resources"
    cp "$BIN_DIR/sparkview" "$APP_EXE"
    cp "$SRC_DIR/cmd/sparkview/bundle/Info.plist" "$APP_BUNDLE/Contents/Info.plist"
    if [ "$id" = "-" ]; then
        echo "    WARNING: no stable signing identity found; ad-hoc signing — the"
        echo "             Local Network grant will NOT persist across rebuilds."
    fi
    codesign --force --options runtime --identifier "$BUNDLE_ID" \
        --sign "$id" "$APP_BUNDLE" 2>&1 | sed 's/^/    /'
    echo "    Bundled -> output/SparkView.app"
    codesign -dv "$APP_BUNDLE" 2>&1 | grep -E "Identifier|TeamIdentifier|Authority=Apple Development|Authority=Developer ID" | sed 's/^/    /' || true
}

cmd_test() {
    local pkg="${1:-./...}"
    shift 2>/dev/null || true
    cd "$SRC_DIR"
    echo "==> Testing $pkg"
    go test "$pkg" -count=1 -v "$@" 2>&1 | tee "$TEST_DIR/test.log"
    echo "==> Test output written to output/testing/test.log"
}

cmd_lint() {
    cd "$SRC_DIR"
    local failed=0

    echo "==> Checking formatting..."
    if [ -n "$(gofmt -l .)" ]; then
        echo "FAIL: gofmt found unformatted files:"
        gofmt -l .
        failed=1
    else
        echo "    gofmt: clean"
    fi

    echo "==> Running go vet..."
    if ! go vet ./...; then
        failed=1
    else
        echo "    go vet: clean"
    fi

    echo "==> Running golangci-lint..."
    if command -v golangci-lint &>/dev/null; then
        if ! golangci-lint run ./...; then
            failed=1
        else
            echo "    golangci-lint: clean"
        fi
    else
        echo "    golangci-lint: not installed, skipping"
    fi

    if [ "$failed" -ne 0 ]; then
        echo "==> Lint FAILED"
        return 1
    fi
    echo "==> Lint passed."
}

cmd_check() {
    echo "==> Running full quality gate..."
    cmd_lint
    echo ""
    cd "$SRC_DIR"
    echo "==> Running all tests..."
    go test ./... -count=1 -v 2>&1 | tee "$TEST_DIR/check.log"
    echo "==> Quality gate PASSED. Safe to commit."
}

cmd_run() {
    cmd_build
    echo "==> Running (signed bundle)..."
    exec "$APP_EXE" "$@"
}

cmd_install() {
    # Install the supervising launcher as the entrypoint auto runs. The launcher
    # (not the GUI binary) is what auto keeps alive; it relaunches the GUI on any
    # exit — crash, Gio teardown panic, or intermittent macOS EDEADLK — so Spark
    # View can never stay dead. See src/launcher/sparkview-launcher.
    local launcher="$SRC_DIR/launcher/sparkview-launcher"
    local target="$HOME/bin/sparkview"
    echo "==> Installing launcher -> $target"
    mkdir -p "$HOME/bin"
    install -m 0755 "$launcher" "$target"
    echo "    Installed."
}

cmd_rebuild() {
    cmd_build
    cmd_install
    echo "==> Restarting via auto..."
    ~/local/auto/run -q restart sparkview
}

cmd_logs() {
    # Spark View logs to stderr (startup, App Nap, poll connect/disconnect
    # transitions, right-click actions, watchdog restarts); `auto` captures that
    # into a timestamped per-launch file. Tail the most recent one.
    # `|| true` guards: under `set -euo pipefail` a SIGPIPE from `head` closing
    # early, or a non-zero `find`, would otherwise abort the script silently.
    local logdir
    logdir="$( (find "$HOME/local/auto/output/logs/sparkview" -type d -name '[0-9][0-9]' 2>/dev/null | sort | tail -1) || true )"
    if [ -z "$logdir" ]; then
        echo "No Spark View logs found under ~/local/auto/output/logs/sparkview" >&2
        exit 1
    fi
    local latest
    latest="$( (ls -t "$logdir"/sparkview_*.log 2>/dev/null | head -1) || true )"
    if [ -z "$latest" ]; then
        echo "No log files in $logdir" >&2
        exit 1
    fi
    echo "==> Tailing $latest (Ctrl-C to stop)"
    tail -n 50 -f "$latest"
}

case "${1:-}" in
    build) shift; cmd_build "$@" ;;
    test)  shift; cmd_test "$@" ;;
    lint)  shift; cmd_lint "$@" ;;
    check) shift; cmd_check "$@" ;;
    run)     shift; cmd_run "$@" ;;
    install) shift; cmd_install "$@" ;;
    rebuild) shift; cmd_rebuild "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    *)       usage ;;
esac
