<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spark View runs as its OWN LaunchAgent (not under auto, not via a bash
  launcher). launchd execs the signed .app binary directly, so macOS attributes
  Local Network access to the bundle's stable code identity (com.darrenoakey.
  sparkview) — the one the user granted once in System Settings. A bash-launcher
  or auto intermediary becomes the "responsible process" instead and the grant
  never sticks. KeepAlive restarts only on an actual exit (crash / window close);
  there is no self-restart watchdog. __APP_EXE__ / __LOG__ are filled in by `run`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.darrenoakey.sparkview</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_EXE__</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Interactive</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>StandardErrorPath</key><string>__LOG__</string>
    <key>StandardOutPath</key><string>__LOG__</string>
</dict>
</plist>
